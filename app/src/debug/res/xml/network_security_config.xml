<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

    <!-- Debug only: pairing memakai HTTP ke IP LAN TV. Rilis tetap menolak cleartext. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
